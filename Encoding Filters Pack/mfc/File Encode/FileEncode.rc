#include "resource.h"
#include <afxres.h>

IDI_ICON ICON "visioforge_main_icon.ico"

IDD_FILE_ENCODE DIALOGEX 0, 0, 520, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Encoding Filters Pack - file encode"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "File", IDC_FILE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 8, 36, 10
    CONTROL "Camera", IDC_CAMERA, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 48, 8, 44, 10
    EDITTEXT IDC_SOURCE, 8, 22, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_SOURCE, 262, 21, 16, 14
    COMBOBOX IDC_CAMERA_DEVICE, 8, 40, 270, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_AUDIO_DEVICE, 8, 58, 270, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Encoder", -1, 8, 78, 40, 8
    COMBOBOX IDC_ENCODER, 50, 76, 228, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Video kbps", -1, 8, 96, 46, 8
    EDITTEXT IDC_VBITRATE, 56, 94, 40, 14, ES_NUMBER
    COMBOBOX IDC_RATE, 102, 94, 176, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Container", -1, 8, 114, 42, 8
    COMBOBOX IDC_MUX, 52, 112, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "AAC", IDC_AUDIO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 114, 32, 10
    EDITTEXT IDC_ABITRATE, 176, 112, 36, 14, ES_NUMBER
    LTEXT "kbps", -1, 216, 114, 24, 8
    EDITTEXT IDC_OUTPUT, 8, 132, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_OUTPUT, 262, 131, 16, 14
    PUSHBUTTON "Start", IDC_START, 8, 152, 50, 14
    PUSHBUTTON "Stop", IDC_STOP, 62, 152, 50, 14
    LTEXT "Idle.", IDC_STATUS, 118, 154, 160, 8
    CONTROL "", IDC_PREVIEW, "Static", SS_BLACKRECT | WS_BORDER, 286, 8, 226, 264
END
