#include "resource.h"
#include <afxres.h>

IDD_AUDIO DIALOGEX 0, 0, 280, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Encoding Filters Pack - audio"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "File", IDC_FILE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 8, 36, 10
    CONTROL "Capture device", IDC_DEVICE, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 48, 8, 70, 10
    EDITTEXT IDC_SOURCE, 8, 22, 230, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_SOURCE, 242, 21, 16, 14
    COMBOBOX IDC_AUDIO_DEVICE, 8, 40, 250, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_FORMAT, 8, 58, 120, 40, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_BITRATE, 134, 58, 40, 14, ES_NUMBER
    LTEXT "kbps", -1, 178, 60, 24, 8
    EDITTEXT IDC_OUTPUT, 8, 78, 230, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_OUTPUT, 242, 77, 16, 14
    PUSHBUTTON "Start", IDC_START, 8, 100, 50, 14
    PUSHBUTTON "Stop", IDC_STOP, 62, 100, 50, 14
    LTEXT "Idle.", IDC_STATUS, 118, 102, 140, 20
END
