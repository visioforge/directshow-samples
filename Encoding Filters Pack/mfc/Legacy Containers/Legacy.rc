#include "resource.h"
#include <afxres.h>

IDD_LEGACY DIALOGEX 0, 0, 520, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Encoding Filters Pack - legacy containers"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "File", IDC_FILE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 8, 36, 10
    CONTROL "Camera", IDC_CAMERA, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 48, 8, 44, 10
    EDITTEXT IDC_SOURCE, 8, 22, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_SOURCE, 262, 21, 16, 14
    COMBOBOX IDC_CAMERA_DEVICE, 8, 40, 270, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_AUDIO_DEVICE, 8, 58, 270, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_FORMAT, 8, 76, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_TV, 144, 76, 70, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_WIDTH, 8, 94, 36, 14, ES_NUMBER
    EDITTEXT IDC_HEIGHT, 48, 94, 36, 14, ES_NUMBER
    EDITTEXT IDC_VBITRATE, 90, 94, 40, 14, ES_NUMBER
    LTEXT "kbps", -1, 132, 96, 22, 8
    CONTROL "Audio", IDC_AUDIO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 96, 36, 10
    EDITTEXT IDC_ABITRATE, 8, 112, 36, 14, ES_NUMBER
    EDITTEXT IDC_RATE, 48, 112, 46, 14, ES_NUMBER
    EDITTEXT IDC_CHANNELS, 98, 112, 24, 14, ES_NUMBER
    LTEXT "kbps Hz ch", -1, 128, 114, 50, 8
    EDITTEXT IDC_OUTPUT, 8, 132, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_OUTPUT, 262, 131, 16, 14
    PUSHBUTTON "Start", IDC_START, 8, 152, 50, 14
    PUSHBUTTON "Stop", IDC_STOP, 62, 152, 50, 14
    LTEXT "Idle.", IDC_STATUS, 118, 154, 150, 16
    CONTROL "", IDC_PREVIEW, "Static", SS_BLACKRECT | WS_BORDER, 286, 8, 226, 264
END
