#include "resource.h"
#include <afxres.h>

IDI_ICON ICON "visioforge_main_icon.ico"

IDD_RTSP DIALOGEX 0, 0, 520, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Encoding Filters Pack - RTSP"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "File", IDC_FILE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 8, 36, 10
    CONTROL "Camera", IDC_CAMERA, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 48, 8, 44, 10
    EDITTEXT IDC_SOURCE, 8, 22, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_SOURCE, 262, 21, 16, 14
    COMBOBOX IDC_CAMERA_DEVICE, 8, 40, 270, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_AUDIO_DEVICE, 8, 58, 270, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "H.264 kbps", -1, 8, 80, 48, 8
    EDITTEXT IDC_VBITRATE, 60, 78, 40, 14, ES_NUMBER
    CONTROL "AAC", IDC_AUDIO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 80, 32, 10
    EDITTEXT IDC_ABITRATE, 146, 78, 36, 14, ES_NUMBER
    LTEXT "kbps", -1, 186, 80, 24, 8
    EDITTEXT IDC_URL, 8, 100, 270, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Start", IDC_START, 8, 122, 50, 14
    PUSHBUTTON "Stop", IDC_STOP, 62, 122, 50, 14
    LTEXT "Idle.", IDC_STATUS, 118, 124, 160, 20
    CONTROL "", IDC_PREVIEW, "Static", SS_BLACKRECT | WS_BORDER, 286, 8, 226, 264
END
