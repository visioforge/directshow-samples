<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenCaptureSample</RootNamespace>
    <AssemblyName>ScreenCaptureSampleVB</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VisioForge.DirectShowAPI" Version="2025.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="image.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
